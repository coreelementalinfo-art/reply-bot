{
  "compilerOptions": {
    "module": "CommonJS",
    "esModuleInterop": true,
    "target": "ES2021",
    "moduleResolution": "node",
    "strict": true,
    "sourceMap": false,
    "removeComments": true,
    "lib": ["ES2021"],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true
  }
}